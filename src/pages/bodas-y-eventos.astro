---
/**
 * Página para parejas y empresas con un evento. Pesa más la confianza que el catálogo:
 * proceso, testimonios y preguntas frecuentes, además de los trabajos.
 */
import Base from "../layouts/Base.astro";
import CabeceraPagina from "../components/CabeceraPagina.astro";
import TarjetaProyecto from "../components/TarjetaProyecto.astro";
import { obtenerProyectos } from "../lib/proyectos";
import bodas from "../content/paginas/bodas.json";

const proyectos = (await obtenerProyectos("eventos")).slice(0, 3);
---

<Base titulo="Bodas y eventos" descripcion={bodas.intro}>
    <CabeceraPagina etiqueta="Bodas y eventos" titulo={bodas.titular} intro={bodas.intro}>
        <a href="/presupuesto?servicio=boda" class="boton mt-10">Consultar disponibilidad</a>
    </CabeceraPagina>

    {
        proyectos.length > 0 && (
            <section class="contenedor grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" aria-label="Trabajos">
                {proyectos.map((p) => <TarjetaProyecto proyecto={p} />)}
            </section>
        )
    }

    <section class="mt-28 bg-surface py-20 sm:py-28" aria-labelledby="titulo-proceso">
        <div class="contenedor">
            <h2 id="titulo-proceso" class="titulo-display text-4xl sm:text-6xl">Cómo trabajamos</h2>
            <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
                {
                    bodas.proceso.map((p, i) => (
                        <li>
                            <span class="font-serif text-xl text-accent">{String(i + 1).padStart(2, "0")}</span>
                            <h3 class="mt-2 font-serif text-3xl">{p.paso}</h3>
                            <p class="mt-3 text-muted">{p.descripcion}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    {
        bodas.testimonios.length > 0 && (
            <section class="contenedor py-20 sm:py-28" aria-label="Testimonios">
                <div class="grid gap-16 md:grid-cols-2">
                    {bodas.testimonios.map((t) => (
                        <figure>
                            <blockquote class="font-serif text-3xl leading-snug text-balance sm:text-4xl">
                                “{t.texto}”
                            </blockquote>
                            <figcaption class="etiqueta mt-6">{t.autor}</figcaption>
                        </figure>
                    ))}
                </div>
            </section>
        )
    }

    {
        bodas.preguntas.length > 0 && (
            <section class="contenedor grid gap-10 md:grid-cols-[1fr_2fr]" aria-labelledby="titulo-faq">
                <h2 id="titulo-faq" class="titulo-display text-4xl sm:text-5xl">Preguntas frecuentes</h2>
                <div class="border-t border-line">
                    {bodas.preguntas.map((p) => (
                        <details class="group border-b border-line py-6">
                            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
                                {p.pregunta}
                                <span aria-hidden="true" class="font-serif text-2xl leading-none transition-transform group-open:rotate-45">
                                    +
                                </span>
                            </summary>
                            <p class="mt-4 max-w-prose text-muted">{p.respuesta}</p>
                        </details>
                    ))}
                </div>
            </section>
        )
    }
</Base>
