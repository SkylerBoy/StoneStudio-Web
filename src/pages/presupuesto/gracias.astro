---
import { ruta } from "../../lib/rutas";
import Base from "../../layouts/Base.astro";
---

<Base titulo="Solicitud enviada" noIndexar>
    <section class="contenedor py-24 sm:py-36">
        <p class="etiqueta">Solicitud enviada</p>
        <h1 class="titulo-display mt-4 max-w-3xl text-5xl sm:text-7xl">Gracias, ya tenemos tu mensaje.</h1>
        <p class="mt-6 max-w-xl text-lg text-muted">
            Te respondemos en uno o dos días laborables. Mientras tanto, puedes echar un vistazo a
            más trabajos.
        </p>
        <a href={ruta("/portfolio")} class="boton mt-10">Ver el portfolio</a>
    </section>
</Base>
