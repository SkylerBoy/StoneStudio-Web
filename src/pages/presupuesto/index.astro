---
/**
 * Formulario de presupuesto con Netlify Forms: sin servidor ni claves. Netlify detecta el
 * formulario al publicar (atributo data-netlify), guarda los envíos y avisa por email.
 * Funciona sin JavaScript; el script solo preselecciona el servicio desde la URL.
 *
 * Si se cambia de hosting, hay que sustituir esto por otro servicio (Formspree, Web3Forms…).
 */
import Base from "../../layouts/Base.astro";
import CabeceraPagina from "../../components/CabeceraPagina.astro";
import { ajustes } from "../../lib/ajustes";

const servicios = [
    { valor: "marcas", texto: "Fotografía para marcas o producto" },
    { valor: "boda", texto: "Boda" },
    { valor: "evento", texto: "Evento de empresa u otra celebración" },
    { valor: "edicion", texto: "Solo edición o retoque" },
];

const campo = "mt-2 w-full rounded-none border-0 border-b border-line bg-transparent px-0 py-3 text-base focus:border-text focus:ring-0 focus:outline-none";
const etiqueta = "text-sm font-medium";
---

<Base
    titulo="Pedir presupuesto"
    descripcion="Cuéntanos tu proyecto y te enviamos un presupuesto sin compromiso."
>
    <CabeceraPagina
        etiqueta="Presupuesto"
        titulo="Cuéntanos qué tienes en mente"
        intro="Cada proyecto es distinto, así que preparamos los presupuestos a medida. Respondemos en uno o dos días laborables."
    />

    <section class="contenedor grid gap-16 lg:grid-cols-[2fr_1fr]">
        <form
            name="presupuesto"
            method="POST"
            action="/presupuesto/gracias"
            data-netlify="true"
            netlify-honeypot="campo-trampa"
            class="grid gap-8 sm:grid-cols-2"
        >
            <input type="hidden" name="form-name" value="presupuesto" />
            <p class="hidden">
                <label>No rellenes este campo: <input name="campo-trampa" tabindex="-1" autocomplete="off" /></label>
            </p>

            <label class="block">
                <span class={etiqueta}>Nombre *</span>
                <input class={campo} type="text" name="nombre" autocomplete="name" required />
            </label>
            <label class="block">
                <span class={etiqueta}>Email *</span>
                <input class={campo} type="email" name="email" autocomplete="email" required />
            </label>
            <label class="block">
                <span class={etiqueta}>Teléfono</span>
                <input class={campo} type="tel" name="telefono" autocomplete="tel" />
            </label>
            <label class="block">
                <span class={etiqueta}>¿Qué necesitas? *</span>
                <select class={campo} name="servicio" id="campo-servicio" required>
                    <option value="" disabled selected>Elige una opción</option>
                    {servicios.map((s) => <option value={s.valor}>{s.texto}</option>)}
                </select>
            </label>
            <label class="block">
                <span class={etiqueta}>Fecha</span>
                <span class="block text-xs text-muted">Del evento o de cuándo lo necesitas, si ya la sabes.</span>
                <input class={campo} type="date" name="fecha" />
            </label>
            <label class="block">
                <span class={etiqueta}>Lugar</span>
                <span class="block text-xs text-muted">Ciudad o espacio.</span>
                <input class={campo} type="text" name="lugar" />
            </label>
            <label class="block sm:col-span-2">
                <span class={etiqueta}>Cuéntanos un poco más *</span>
                <span class="block text-xs text-muted">
                    Número de productos o de invitados, estilo que te gusta, para qué usarás las fotos…
                </span>
                <textarea class={`${campo} min-h-40 resize-y`} name="mensaje" rows="5" required></textarea>
            </label>
            <label class="flex items-start gap-3 text-sm sm:col-span-2">
                <input type="checkbox" name="privacidad" value="aceptada" required class="mt-0.5 size-4 accent-text" />
                <span>
                    He leído la <a href="/privacidad" class="enlace">política de privacidad</a> y acepto que
                    usemos estos datos para responder a mi solicitud. *
                </span>
            </label>
            <div class="sm:col-span-2">
                <button type="submit" class="boton">Enviar solicitud</button>
            </div>
        </form>

        <aside class="space-y-8 text-sm">
            <div>
                <h2 class="etiqueta mb-3">¿Prefieres escribirnos?</h2>
                <ul class="space-y-2">
                    <li><a class="enlace" href={ajustes.mailto}>{ajustes.email}</a></li>
                    {
                        ajustes.whatsappUrl && (
                            <li>
                                <a class="enlace" href={ajustes.whatsappUrl} rel="noopener" target="_blank">
                                    WhatsApp
                                </a>
                            </li>
                        )
                    }
                    {
                        ajustes.instagramUrl && (
                            <li>
                                <a class="enlace" href={ajustes.instagramUrl} rel="noopener" target="_blank">
                                    @{ajustes.instagram}
                                </a>
                            </li>
                        )
                    }
                </ul>
            </div>
        </aside>
    </section>
</Base>

<script>
    // /presupuesto?servicio=boda llega desde los botones de cada página de servicio.
    const select = document.getElementById("campo-servicio") as HTMLSelectElement | null;
    const servicio = new URLSearchParams(location.search).get("servicio");
    if (select && servicio && [...select.options].some((o) => o.value === servicio)) {
        select.value = servicio;
    }
</script>
