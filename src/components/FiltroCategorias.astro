---
/**
 * Pestañas del portfolio. Son enlaces a páginas reales (/portfolio/marcas…), no un filtro
 * en JavaScript: así cada categoría tiene su URL para compartir y para Google.
 */
import { CATEGORIAS } from "../lib/proyectos";
import { ruta, rutaActual } from "../lib/rutas";

const actual = rutaActual(Astro.url);
const opciones = [
    { destino: "/portfolio", texto: "Todo" },
    ...Object.entries(CATEGORIAS).map(([clave, c]) => ({ destino: `/portfolio/${clave}`, texto: c.nombre })),
];
---

<nav aria-label="Categorías del portfolio" class="mt-10 flex flex-wrap gap-2">
    {
        opciones.map((o) => (
            <a
                href={ruta(o.destino)}
                aria-current={actual === o.destino ? "page" : undefined}
                class="rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-text aria-[current=page]:border-text aria-[current=page]:bg-text aria-[current=page]:text-background"
            >
                {o.texto}
            </a>
        ))
    }
</nav>
