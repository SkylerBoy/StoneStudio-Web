---
/**
 * Cabecera. En la portada va transparente y en blanco sobre la foto; al bajar (o en el
 * resto de páginas) pasa a fondo hueso. En móvil el menú se abre a pantalla completa.
 */
import { ruta, rutaActual } from "../lib/rutas";

interface Props {
    sobreFoto?: boolean;
}
const { sobreFoto = false } = Astro.props;

const enlaces = [
    { destino: "/portfolio", texto: "Portfolio" },
    { destino: "/marcas", texto: "Marcas" },
    { destino: "/bodas-y-eventos", texto: "Bodas y eventos" },
    { destino: "/estudio", texto: "Estudio" },
].map((e) => ({ ...e, href: ruta(e.destino) }));

const actual = rutaActual(Astro.url);
const activo = (destino: string) => actual === destino || actual.startsWith(`${destino}/`);
---

<header
    id="cabecera"
    data-sobre-foto={sobreFoto ? "" : undefined}
    class:list={[
        "group/cab top-0 z-40 w-full transition-colors duration-300",
        sobreFoto ? "fixed text-background" : "sticky border-b border-line bg-background/90 backdrop-blur",
    ]}
>
    <div class="contenedor flex h-16 items-center justify-between sm:h-20">
        <a href={ruta("/")} class="font-serif text-2xl tracking-tight sm:text-3xl" aria-label="Stone Studio, inicio">
            Stone Studio
        </a>

        <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
            {
                enlaces.map((e) => (
                    <a
                        href={e.href}
                        aria-current={activo(e.destino) ? "page" : undefined}
                        class="text-sm decoration-1 underline-offset-8 hover:underline aria-[current=page]:underline"
                    >
                        {e.texto}
                    </a>
                ))
            }
            <a
                href={ruta("/presupuesto")}
                class:list={[
                    "rounded-full border px-5 py-2 text-sm font-medium transition-colors",
                    sobreFoto
                        ? "border-background hover:bg-background hover:text-text group-data-[solida]/cab:border-text group-data-[solida]/cab:hover:bg-text group-data-[solida]/cab:hover:text-background"
                        : "border-text hover:bg-text hover:text-background",
                ]}
            >
                Pedir presupuesto
            </a>
        </nav>

        <button
            id="abrir-menu"
            type="button"
            class="-mr-2 p-2 md:hidden"
            aria-expanded="false"
            aria-controls="menu-movil"
        >
            <span class="sr-only">Abrir menú</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M3 8h18M3 16h18"></path>
            </svg>
        </button>
    </div>
</header>

<!-- Fuera del <header>: su backdrop-blur haría que este fixed se midiera contra la
     cabecera y no contra la ventana. -->
<div id="menu-movil" hidden class="fixed inset-0 z-50 flex flex-col bg-background text-text md:hidden">
    <div class="contenedor flex h-16 items-center justify-between">
        <span class="font-serif text-2xl">Stone Studio</span>
        <button id="cerrar-menu" type="button" class="-mr-2 p-2">
            <span class="sr-only">Cerrar menú</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>
    </div>
    <nav aria-label="Principal (móvil)" class="contenedor flex flex-1 flex-col justify-center gap-6 pb-16">
        {
            enlaces.map((e) => (
                <a href={e.href} class="font-serif text-5xl">
                    {e.texto}
                </a>
            ))
        }
        <a href={ruta("/presupuesto")} class="boton mt-6 self-start">Pedir presupuesto</a>
    </nav>
</div>

<script>
    const cabecera = document.getElementById("cabecera");
    const menu = document.getElementById("menu-movil");
    const abrir = document.getElementById("abrir-menu");
    const cerrar = document.getElementById("cerrar-menu");

    function alternarMenu(abierto: boolean) {
        if (!menu || !abrir) return;
        menu.hidden = !abierto;
        abrir.setAttribute("aria-expanded", String(abierto));
        document.body.style.overflow = abierto ? "hidden" : "";
        (abierto ? cerrar : abrir)?.focus();
    }

    abrir?.addEventListener("click", () => alternarMenu(true));
    cerrar?.addEventListener("click", () => alternarMenu(false));
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu && !menu.hidden) alternarMenu(false);
    });

    // Sobre la foto de portada: al pasar de ella, la cabecera se vuelve sólida para que el
    // texto blanco no quede encima de contenido claro.
    if (cabecera?.hasAttribute("data-sobre-foto")) {
        const actualizar = () => {
            const solida = window.scrollY > window.innerHeight * 0.75;
            cabecera.toggleAttribute("data-solida", solida);
            cabecera.classList.toggle("bg-background", solida);
            cabecera.classList.toggle("text-text", solida);
            cabecera.classList.toggle("text-background", !solida);
            cabecera.classList.toggle("border-b", solida);
            cabecera.classList.toggle("border-line", solida);
        };
        actualizar();
        window.addEventListener("scroll", actualizar, { passive: true });
    }
</script>
